# Create Aeronautics Physics Server — server/.env.example
# Copy to server/.env and fill in. server/.env is gitignored.
#
# Everything that changes when the server moves to different hardware is in
# this file. Moving hosts should be: edit this, restore one backup, start.

# ---- platform ---------------------------------------------------------------
TZ=Australia/Sydney

# The exact NeoForge 21.1.x build pinned in pack/pack.toml.
# Copy it, do not resolve "latest". One version, one place.
NEOFORGE_VERSION=21.1.CHANGEME

# ---- the pack ---------------------------------------------------------------
# Same URL the clients use in their Prism pre-launch command.
# Use the `release` branch, not `main` and not a tag — see phase 9 §7.2.
# The repo must be public for this to resolve without a token.
PACKWIZ_URL=https://raw.githubusercontent.com/CHANGEME/create-aero-physics/release/pack/pack.toml

# ---- memory -----------------------------------------------------------------
# HEAP is both -Xms and -Xmx. MEM_LIMIT must exceed it by several GB because
# Rapier allocates native memory outside the Java heap.
#
# Sized for the Dell Latitude 5400: i5-8365U (4c/8t, 15W), 32 GB RAM.
# 10G not 12G on purpose: there IS the RAM, but the constraint is core count,
# and a bigger heap on four cores means longer collections.
#
# .wslconfig (%UserProfile%\.wslconfig):  memory=22GB  processors=8  swap=0
HEAP=10G
MEM_LIMIT=15g

# Only set if the production host is shared with something else.
# Starving the physics threads is worse than the host being busy.
CPU_LIMIT=

# Empty = G1 with Aikar's flags (the boring option).
# Generational ZGC swap-in, if spark ever attributes stalls to GC:
#   JVM_XX_OPTS=-XX:+UseZGC -XX:+ZGenerational
# Remove USE_AIKAR_FLAGS from the compose file if you do — they are G1 flags.
JVM_XX_OPTS=

# ---- world ------------------------------------------------------------------
# Phase 9.5 sets the final values. Phase 8 §12 wants simulation distance high
# enough that contraptions stop vanishing at the boundary — that is this knob.
# VIEW_DISTANCE 8 is nearly free: DH is what lets you see 2048 blocks, so the
# vanilla view distance buys nothing visually. Cheapest win on this CPU.
VIEW_DISTANCE=8
SIMULATION_DISTANCE=10

# ---- backups ----------------------------------------------------------------
# A path on the HOST, deliberately outside the WSL2 filesystem so you can see
# and copy the tarballs from Windows. Large sequential writes tolerate the
# boundary; the world does not, which is why the world is a named volume.
#   Windows: C:/mcbackups
#   Linux:   /srv/mcbackups
BACKUP_DIR=C:/mcbackups
